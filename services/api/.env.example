# Copy to .env and fill in real values (never commit .env - it's gitignored).

# Postgres. Matches the defaults in the repo-root docker-compose.yml; change
# the credentials here and there together.
DATABASE_URL=postgresql://cos:cos_dev_password@localhost:5432/cos

# Session signing secret, 32+ characters. Rotating it invalidates every
# existing session, which is the intended emergency lever.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of this API. Used to build auth callback URLs, so it must be
# the address a browser actually reaches, not an internal container name.
BETTER_AUTH_URL=http://localhost:3200

# Comma-separated origins allowed to call this API with credentials.
# The web app in development runs on 3100.
WEB_ORIGINS=http://localhost:3100

PORT=3200
NODE_ENV=development

# S3-compatible object storage for uploaded document files. Authored text
# documents live in Postgres and do not use any of this.
#
# The defaults match the MinIO service in the repo-root docker-compose.yml, so
# `docker compose up -d` is enough for local development and none of these
# need to be set. For Cloudflare R2 use
# https://<account>.r2.cloudflarestorage.com; for real AWS S3 leave
# STORAGE_ENDPOINT empty and set STORAGE_FORCE_PATH_STYLE=false.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=cos-documents
STORAGE_ACCESS_KEY_ID=cos_dev_access_key
STORAGE_SECRET_ACCESS_KEY=cos_dev_secret_key
STORAGE_FORCE_PATH_STYLE=true

# OnlyOffice Docs CE - real docx/xlsx/pptx editing. Optional: a self-hoster
# who only authors markdown/text documents never needs this container
# running, and the routes it gates answer "not configured" without it rather
# than the API failing to start.
#
# Generate a secret with: openssl rand -base64 32
ONLYOFFICE_JWT_SECRET=
# What the OnlyOffice *container* uses to reach back to this API (its
# download fetch and its save callback) - not the browser-facing address.
# This API still runs on the host, not inside docker-compose.yml's network,
# so host.docker.internal (Docker Desktop's and OrbStack's name for "the
# host machine, from inside a container") is the default rather than a
# container DNS name like http://api:3200.
ONLYOFFICE_CALLBACK_ORIGIN=http://host.docker.internal:3200
