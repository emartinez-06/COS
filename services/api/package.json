{
  "name": "@cos/api",
  "version": "0.0.0",
  "private": true,
  "description": "COS API: auth, clubs, members, documents, audit ledger, realtime feed",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx ./src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file-if-exists=.env --import tsx ./src/db/seed.ts"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@cos/core": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-openapi": "^1.5.1",
    "@scalar/hono-api-reference": "^0.11.11",
    "@tiptap/core": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "@tiptap/y-tiptap": "^3.0.9",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^14.3.0",
    "pg": "^8.22.0",
    "prosemirror-markdown": "^1.13.6",
    "prosemirror-model": "^1.25.11",
    "ws": "^8.18.3",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  }
}
