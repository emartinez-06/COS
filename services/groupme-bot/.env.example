# Copy to .env and fill in real values (never commit .env - it's gitignored).

# From https://dev.groupme.com/bots - required on X-Access-Token header for
# any GroupMe API call other than posting as a bot (e.g. GET /v3/groups).
GROUPME_ACCESS_TOKEN=

# From the bot's dashboard entry after creation - the only credential needed
# to POST https://api.groupme.com/v3/bots/post as this bot.
GROUPME_BOT_ID=

# Test group used during v0.1 development.
GROUPME_GROUP_ID=
GROUPME_GROUP_NAME=

# Avatar shown for the bot in the group.
GROUPME_BOT_AVATAR_URL=
