{
  "name": "cos",
  "private": true,
  "description": "Club Organizational Software: an open-source connective layer for student clubs",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @cos/core build && pnpm --filter @cos/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @cos/core build && pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
